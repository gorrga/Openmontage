  "lyrics": [
    {
      "text": "Sight words, sight words, we know them by sight! Read them fast, read them right! Let's go!",
      "inSeconds": 0.5,
      "outSeconds": 10.91,
      "section": "intro"
    },
    {
      "text": "I - I am me! The - the one and only!",
      "inSeconds": 10.91,
      "outSeconds": 17.65,
      "section": "verse"
    },
    {
      "text": "A - just one letter! Is - it is a great day!",
      "inSeconds": 17.65,
      "outSeconds": 25.0,
      "section": "verse"
    },
    {
      "text": "I, the, a, is! I, the, a, is!",
      "inSeconds": 25.0,
      "outSeconds": 29.77,
      "section": "chorus"
    },
    {
      "text": "Say those sight words, can't dismiss!",
      "inSeconds": 29.77,
      "outSeconds": 33.34,
      "section": "chorus"
    },
    {
      "text": "It, in, on, can - four more today!",
      "inSeconds": 33.34,
      "outSeconds": 38.11,
      "section": "chorus"
    },
    {
      "text": "See and we - hip hip hooray!",
      "inSeconds": 38.11,
      "outSeconds": 42.28,
      "section": "chorus"
    },
    {
      "text": "It - it's so easy! In - jump in!",
      "inSeconds": 42.28,
      "outSeconds": 47.64,
      "section": "verse"
    },
    {
      "text": "On - climb on! Can - yes I can!",
      "inSeconds": 47.64,
      "outSeconds": 53.0,
      "section": "verse"
    },
    {
      "text": "I, the, a, is! I, the, a, is!",
