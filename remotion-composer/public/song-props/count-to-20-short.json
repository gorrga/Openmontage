  "lyrics": [
    {
      "text": "Put on your cape, it's time to count! Superheroes ready? Let's shout it out!",
      "inSeconds": 0.5,
      "outSeconds": 5.4,
      "section": "intro"
    },
    {
      "text": "ONE! Superhero pose! TWO! Flex those muscles!",
      "inSeconds": 5.4,
      "outSeconds": 9.54,
      "section": "verse"
    },
    {
      "text": "THREE! Fly through the air! FOUR! Land with a boom!",
      "inSeconds": 9.54,
      "outSeconds": 15.45,
      "section": "verse"
    },
    {
      "text": "FIVE! High five, you're halfway there!",
      "inSeconds": 15.45,
      "outSeconds": 19.0,
      "section": "verse"
    },
    {
      "text": "Count like a superhero, 1 2 3!",
