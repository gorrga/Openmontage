  "title": "A is for AMAZING!",
  "lyrics": [
    {
      "text": "Hey friends! Are you ready to learn your letters?",
      "inSeconds": 0.6,
      "outSeconds": 5.17,
      "section": "intro"
    },
    {
      "text": "Let's move, let's sing, let's go!",
      "inSeconds": 5.17,
      "outSeconds": 8.21,
      "section": "intro"
    },
    {
      "text": "A is for amazing, let's stomp our feet!",
      "inSeconds": 8.21,
      "outSeconds": 12.28,
      "section": "verse"
    },
    {
      "text": "B is for bouncing, feel the beat!",
      "inSeconds": 12.28,
      "outSeconds": 15.83,
      "section": "verse"
    },
    {
      "text": "C is for clapping, clap along!",
      "inSeconds": 15.83,
      "outSeconds": 18.88,
      "section": "verse"
    },
    {
      "text": "D is for dancing to this song!",
      "inSeconds": 18.88,
      "outSeconds": 22.43,
      "section": "verse"
    },
    {
      "text": "A B C D E F G!",
      "inSeconds": 22.43,
      "outSeconds": 25.98,
      "section": "chorus"
    },
    {
      "text": "Every letter is a friend to me!",
      "inSeconds": 25.98,
      "outSeconds": 29.54,
      "section": "chorus"
    },
    {
      "text": "H I J K L M N!",
