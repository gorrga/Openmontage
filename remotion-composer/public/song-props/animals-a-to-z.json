{
  "audioSrc": "song/animals-a-to-z.mp3",
  "title": "Animal Alphabet Song \u2014 A to Z Animals!",
  "lyrics": [
    {
      "text": "Get ready to meet the animals \u2014 from A all the way to Z! Here we go!",
      "inSeconds": 0.5,
      "outSeconds": 8.74,
      "section": "intro"
    },
    {
      "text": "A is for Alligator \ud83d\udc0a \u2014 snap, snap, snap!",
      "inSeconds": 8.74,
      "outSeconds": 13.1,
      "section": "verse"
    },
    {
      "text": "B is for Bear \ud83d\udc3b \u2014 give a great big clap!",
      "inSeconds": 13.1,
      "outSeconds": 18.42,
      "section": "verse"
    },
    {
      "text": "C is for Cat \ud83d\udc31 \u2014 meow, meow, meow!",
      "inSeconds": 18.42,
      "outSeconds": 22.78,
      "section": "verse"
    },
    {
      "text": "D is for Dog \ud83d\udc36 \u2014 take a doggy bow!",
      "inSeconds": 22.78,
      "outSeconds": 27.63,
      "section": "verse"
    },
    {
      "text": "E is for Elephant \ud83d\udc18 \u2014 stomp the ground!",
      "inSeconds": 27.63,
      "outSeconds": 31.99,
      "section": "verse"
    },
    {
      "text": "F is for Fox \ud83e\udd8a \u2014 spin around!",
      "inSeconds": 31.99,
      "outSeconds": 35.86,
      "section": "verse"
    },
    {
      "text": "Animals, animals, A to Z!",
      "inSeconds": 35.86,
      "outSeconds": 38.29,
      "section": "chorus"
    },
    {
      "text": "Stomp and roar and sing with me!",
      "inSeconds": 38.29,
      "outSeconds": 41.68,
      "section": "chorus"
    },
    {
      "text": "Furry, feathery, big and small \u2014",
      "inSeconds": 41.68,
      "outSeconds": 44.58,
      "section": "chorus"
    },
    {
      "text": "We love animals, one and all!",
      "inSeconds": 44.58,
      "outSeconds": 47.49,
      "section": "chorus"
    },
    {
      "text": "G is for Giraffe \ud83e\udd92 \u2014 stretch up high!",
      "inSeconds": 47.49,
      "outSeconds": 51.85,
      "section": "verse"
    },
    {
      "text": "H is for Horse \ud83d\udc34 \u2014 gallop on by!",
